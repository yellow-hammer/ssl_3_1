// Пример модульного теста Vanessa-ADD (xddTestRunner).
//
// Исходники тестовой обработки хранятся в src/tests; сборка в tests/*.epf -
// команда «Собрать unit тесты» (vrunner compileepf src/tests tests).
// Панель тестирования собирает обработку автоматически перед прогоном.
//
// Запуск из командной строки: vrunner xunit tests/Тесты_Арифметика.epf --settings env.json

Перем КонтекстЯдра;
Перем Утверждения;

Процедура Инициализация(КонтекстЯдраПараметр) Экспорт
	КонтекстЯдра = КонтекстЯдраПараметр;
	Утверждения = КонтекстЯдра.Плагин("БазовыеУтверждения");
КонецПроцедуры

Функция ПолучитьСписокТестов() Экспорт
	ВсеТесты = Новый Массив;
	ВсеТесты.Добавить("ТестДолжен_ПроверитьСложениеЧисел");
	ВсеТесты.Добавить("ТестДолжен_ПроверитьУмножениеЧисел");
	ВсеТесты.Добавить("ТестДолжен_ПроверитьРаботуСоСтроками");
	Возврат ВсеТесты;
КонецФункции

Процедура ТестДолжен_ПроверитьСложениеЧисел() Экспорт
	Утверждения.ПроверитьРавенство(2 + 2, 4, "Сложение целых чисел");
КонецПроцедуры

Процедура ТестДолжен_ПроверитьУмножениеЧисел() Экспорт
	Утверждения.ПроверитьРавенство(3 * 7, 21, "Умножение целых чисел");
КонецПроцедуры

Процедура ТестДолжен_ПроверитьРаботуСоСтроками() Экспорт
	Утверждения.ПроверитьРавенство(СокрЛП("  строка  "), "строка", "СокрЛП убирает пробелы");
	Утверждения.ПроверитьРавенство(ВРег("тест"), "ТЕСТ", "ВРег переводит в верхний регистр");
КонецПроцедуры
