// Пример тестов OneUnit к классу lib/Калькулятор.os.
//
// Тесты намеренно проверяют не всё: сложение и процент проверены с двух сторон,
// а границы условий и предельная скидка - нет. Обычный прогон из панели
// тестирования будет зелёным, а мутационное тестирование покажет, какие
// изменения кода тесты не заметят.

#Использовать asserts
#Использовать "../lib"

Перем Калькулятор;

&ПередКаждым
Процедура СоздатьКалькулятор() Экспорт

	Калькулятор = Новый Калькулятор();

КонецПроцедуры

&Тест
Процедура СложениеСкладываетЧисла() Экспорт

	Ожидаем.Что(Калькулятор.Сложить(2, 3), "Сумма").Равно(5);
	Ожидаем.Что(Калькулятор.Сложить(-2, 2), "Сумма с разными знаками").Равно(0);

КонецПроцедуры

&Тест
Процедура УмножениеУмножаетЧисла() Экспорт

	Ожидаем.Что(Калькулятор.Умножить(3, 7), "Произведение").Равно(21);
	Ожидаем.Что(Калькулятор.Умножить(3, 0), "Произведение на ноль").Равно(0);

КонецПроцедуры

&Тест
Процедура ПроцентСчитаетсяОтСуммы() Экспорт

	Ожидаем.Что(Калькулятор.ПроцентОтСуммы(1000, 10), "Десять процентов").Равно(100);
	Ожидаем.Что(Калькулятор.ПроцентОтСуммы(100.55, 3), "Округление до копеек").Равно(3.02);

КонецПроцедуры

&Тест
Процедура СкидкаСчитаетсяПоПроценту() Экспорт

	// Предельная скидка здесь не достигается: ограничение сверху не проверено

	Ожидаем.Что(Калькулятор.Скидка(1000, 10, 500), "Скидка по проценту").Равно(100);

КонецПроцедуры

&Тест
Процедура СуммаВнутриПределовПринимается() Экспорт

	// Проверена только середина отрезка: границы не проверены

	Ожидаем.Что(Калькулятор.СуммаВПределах(500, 100, 1000), "Сумма внутри пределов").ЭтоИстина();

КонецПроцедуры
