// Пример теста OneScript (1testrunner, аннотационный стиль).
//
// Запуск из командной строки:
//   1testrunner -run tests/Тест_РаботаСоСтроками.os
// или из панели тестирования VS Code (расширение 1C: Platform Tools).

#Использовать asserts

&Тест
Процедура ТестДолжен_ПроверитьСокращениеПробелов() Экспорт
	Ожидаем.Что(СокрЛП("  строка  "), "СокрЛП убирает пробелы по краям").Равно("строка");
КонецПроцедуры

&Тест
Процедура ТестДолжен_ПроверитьПреобразованиеРегистра() Экспорт
	Ожидаем.Что(ВРег("тест"), "ВРег переводит в верхний регистр").Равно("ТЕСТ");
	Ожидаем.Что(НРег("ТЕСТ"), "НРег переводит в нижний регистр").Равно("тест");
КонецПроцедуры

&Тест
Процедура ТестДолжен_ПроверитьРазделениеСтроки() Экспорт
	Части = СтрРазделить("а;б;в", ";");
	Ожидаем.Что(Части.Количество(), "СтрРазделить вернула три элемента").Равно(3);
	Ожидаем.Что(Части[0], "Первый элемент").Равно("а");
КонецПроцедуры
