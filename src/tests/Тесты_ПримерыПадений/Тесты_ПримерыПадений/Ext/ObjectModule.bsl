// Примеры НАМЕРЕННО падающих тестов Vanessa-ADD (xddTestRunner) -
// чтобы видеть красные статусы и сообщения об ошибках в панели тестирования.

Перем КонтекстЯдра;
Перем Утверждения;

Процедура Инициализация(КонтекстЯдраПараметр) Экспорт
	КонтекстЯдра = КонтекстЯдраПараметр;
	Утверждения = КонтекстЯдра.Плагин("БазовыеУтверждения");
КонецПроцедуры

Функция ПолучитьСписокТестов() Экспорт
	ВсеТесты = Новый Массив;
	ВсеТесты.Добавить("ТестДолжен_Упасть_НеверноеРавенство");
	ВсеТесты.Добавить("ТестДолжен_Упасть_Исключение");
	ВсеТесты.Добавить("ТестДолжен_Пройти_ДляКонтраста");
	Возврат ВсеТесты;
КонецФункции

Процедура ТестДолжен_Упасть_НеверноеРавенство() Экспорт
	Утверждения.ПроверитьРавенство(2 + 2, 5, "Намеренно неверное ожидание: 2 + 2 не равно 5");
КонецПроцедуры

Процедура ТестДолжен_Упасть_Исключение() Экспорт
	ВызватьИсключение "Намеренное исключение для примера падения";
КонецПроцедуры

Процедура ТестДолжен_Пройти_ДляКонтраста() Экспорт
	Утверждения.ПроверитьРавенство(1, 1, "Контрольный зелёный тест");
КонецПроцедуры
