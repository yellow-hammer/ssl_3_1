#Использовать v8find

Перем ИсточникВерсии;

Процедура ПоднятьСерверАдминистрирования()

	Версия = ВерсияПлатформы();
	ПутьКRac = Платформа1С.ПутьКRAC(Версия, РазрядностьПлатформы.x64x86);

	Если ПустаяСтрока(ПутьКRac) Тогда
		ВызватьИсключение "Не найдена платформа " + Версия + ". Укажите установленную версию в " + ИсточникВерсии + ".";
	КонецЕсли;

	ПутьКRas = ПутьКRasРядомСRac(ПутьКRac);
	Порт = "1545";
	АдресАгента = "localhost:1540";
	Сообщить(ПутьКRas + " cluster --port=" + Порт + " " + АдресАгента);

	КодВозврата = 0;
	ЗапуститьПриложение("""" + ПутьКRas + """ cluster --port=" + Порт + " " + АдресАгента, Новый Файл(ПутьКRas).Путь, Истина, КодВозврата);

	Если КодВозврата <> 0 Тогда
		ЗавершитьРаботу(КодВозврата);
	КонецЕсли;

КонецПроцедуры

Функция ПутьКRasРядомСRac(ПутьКRac)

	ИмяФайла = "ras";
	Если НРег(Прав(ПутьКRac, 4)) = ".exe" Тогда
		ИмяФайла = "ras.exe";
	КонецЕсли;

	ПутьКRas = ОбъединитьПути(Новый Файл(ПутьКRac).Путь, ИмяФайла);
	Если Не Новый Файл(ПутьКRas).Существует() Тогда
		ВызватьИсключение "Не найден " + ПутьКRas;
	КонецЕсли;

	Возврат ПутьКRas;

КонецФункции

// vanessa-runner 2 читает env.json, 3 — autumn-properties.json.
Функция ВерсияПлатформы()

	Корень = ОбъединитьПути(ТекущийСценарий().Каталог, "..");

	Если ЭтоVrunner3(Корень) Тогда
		ИсточникВерсии = "autumn-properties.json, ключ v8version";
		Версия = ВерсияИзСекции(ОбъединитьПути(Корень, "autumn-properties.json"), "vrunner", "v8version");
	Иначе
		ИсточникВерсии = "env.json, ключ --v8version";
		Версия = ВерсияИзСекции(ОбъединитьПути(Корень, "env.json"), "default", "--v8version");
	КонецЕсли;

	Если ПустаяСтрока(Версия) Тогда
		Версия = "8";
	КонецЕсли;

	Возврат Версия;

КонецФункции

Функция ВерсияИзСекции(Путь, ИмяСекции, Ключ)

	Если ПустаяСтрока(Путь) Тогда
		Возврат "";
	КонецЕсли;

	Данные = ПрочитатьСоответствие(Путь);
	Если Данные = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Возврат СтрокаЗначения(Данные.Получить(ИмяСекции), Ключ);

КонецФункции

Функция СтрокаЗначения(Секция, Ключ)

	Если Секция = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Значение = Секция.Получить(Ключ);
	Если Значение = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Возврат СокрЛП(Строка(Значение));

КонецФункции

Функция ПрочитатьСоответствие(Путь)

	ФайлНастроек = Новый Файл(Путь);
	Если Не ФайлНастроек.Существует() Тогда
		Возврат Неопределено;
	КонецЕсли;

	Чтение = Новый ЧтениеJSON;
	Чтение.ОткрытьФайл(Путь);
	Данные = ПрочитатьJSON(Чтение, Истина);
	Чтение.Закрыть();

	Возврат Данные;

КонецФункции

Функция ЭтоVrunner3(Корень)

	Версия = ВерсияУстановленногоRunner(Корень);
	Если ПустаяСтрока(Версия) Тогда
		Версия = ВерсияRunnerВМанифесте(ОбъединитьПути(Корень, "packagedef"));
	КонецЕсли;

	Возврат Лев(СокрЛП(Версия), 1) = "3";

КонецФункции

Функция ВерсияУстановленногоRunner(Корень)

	Текст = ПрочитатьТекст(ОбъединитьПути(Корень, "oscript_modules", "vanessa-runner", "opm-metadata.xml"));
	Если ПустаяСтрока(Текст) Тогда
		Возврат "";
	КонецЕсли;

	Маркер = "<version>";
	Начало = СтрНайти(НРег(Текст), Маркер);
	Если Начало = 0 Тогда
		Возврат "";
	КонецЕсли;

	Хвост = Сред(Текст, Начало + СтрДлина(Маркер));
	ПозицияКонца = СтрНайти(НРег(Хвост), "</version>");
	Если ПозицияКонца = 0 Тогда
		Возврат "";
	КонецЕсли;

	Возврат СокрЛП(Лев(Хвост, ПозицияКонца - 1));

КонецФункции

Функция ВерсияRunnerВМанифесте(Путь)

	Текст = ПрочитатьТекст(Путь);
	Если ПустаяСтрока(Текст) Тогда
		Возврат "";
	КонецЕсли;

	Маркер = "vanessa-runner";
	Позиция = СтрНайти(НРег(Текст), Маркер);
	Если Позиция = 0 Тогда
		Возврат "";
	КонецЕсли;

	Хвост = Сред(Текст, Позиция + СтрДлина(Маркер));
	ЗакрытиеИмени = СтрНайти(Хвост, """");
	Если ЗакрытиеИмени = 0 Тогда
		Возврат "";
	КонецЕсли;

	ПослеИмени = Сред(Хвост, ЗакрытиеИмени + 1);
	Открывающая = СтрНайти(ПослеИмени, """");
	Если Открывающая = 0 Тогда
		Возврат "";
	КонецЕсли;

	После = Сред(ПослеИмени, Открывающая + 1);
	Закрывающая = СтрНайти(После, """");
	Если Закрывающая = 0 Тогда
		Возврат "";
	КонецЕсли;

	Возврат Лев(После, Закрывающая - 1);

КонецФункции

Функция ПрочитатьТекст(Путь)

	ФайлТекста = Новый Файл(Путь);
	Если Не ФайлТекста.Существует() Тогда
		Возврат "";
	КонецЕсли;

	Чтение = Новый ЧтениеТекста(Путь, КодировкаТекста.UTF8);
	Текст = Чтение.Прочитать();
	Чтение.Закрыть();

	Если Текст = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Возврат Текст;

КонецФункции

ПоднятьСерверАдминистрирования();
